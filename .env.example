# Run python tools/configure.py once to generate persistent private secrets.
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
RUNTIME_BOOTSTRAP_SECRET=replace-with-a-private-bootstrap-secret

# Keep SQLite for a local beta, or supply an independent PostgreSQL database.
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/ai_rpg_platform

# Each tavern uses a separate SQLite file by default. PostgreSQL deployments
# may pre-create one database per tavern and enable the template below.
# S1_RUNTIME_DATABASE_URL_TEMPLATE=postgresql+psycopg://user:password@127.0.0.1:5432/s1_{runtime_key}
S1_RUNTIME_AUTO_START=true
S1_RUNTIME_HOST=127.0.0.1
S1_RUNTIME_BASE_PORT=5200
S1_RUNTIME_SEED_ON_START=true
S1_RUNTIME_SCHEDULER_ENABLED=true
# Reuse readiness only for the same live child process; 0 disables health reuse.
RUNTIME_HEALTH_CACHE_SECONDS=5
# Bound unchanged identity snapshots per tavern; 0 disables identity reuse.
RUNTIME_IDENTITY_CACHE_MAX_USERS=1024
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=5500

# S1 AI provider. Never commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=
DEEPSEEK_MODEL=deepseek-v4-pro
MIMO_API_KEY=
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT_SECONDS=600
ADVENTURER_S1_AUTO_DISPATCH_ON_FULL=true
